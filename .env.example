# Copy to .env.local; never commit actual secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact public origin (HTTPS required in production).
AUTH_SITE_URL=http://localhost:3000
# Shared Redis storage is REQUIRED in production. Memory limiter is development-only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate a random secret of at least 32 characters (e.g. openssl rand -hex 32).
AUTH_RATE_LIMIT_SECRET=
# Optional ONLY if your ingress overwrites this header; Vercel is detected automatically.
# Without trusted ingress, all clients share a conservative network limit.
AUTH_TRUSTED_IP_HEADER=
